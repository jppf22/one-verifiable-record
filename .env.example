# MariaDB
MARIADB_ROOT_PASSWORD=change_me_root
MARIADB_DATABASE=wikipedia
MARIADB_USER=ovr
MARIADB_PASSWORD=change_me
INNODB_BUFFER_POOL_SIZE=2G

# Verda Inference API (LLM entailment + embeddings at query time)
VERDA_API_KEY=
VERDA_BASE_URL=https://inference.verda.com/v1
LLM_MODEL=kimi-k3-1-pro
# Kimi K3's low setting leaves output budget for the structured JSON claims.
LLM_REASONING_EFFORT=low
EMBED_MODEL=intfloat/multilingual-e5-large
# Optional remote GPU worker. Set both after provisioning the Verda worker.
GPU_EMBED_BASE_URL=
GPU_EMBED_TOKEN=

# Deployment networking. Keep loopback for local development. On the demo VM,
# set 0.0.0.0 only after the web/API rate limits are in place; expose 8080, not 8000.
OVR_PUBLIC_BIND=127.0.0.1
POST_RATE_LIMIT_PER_MINUTE=12
