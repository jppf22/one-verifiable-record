# MariaDB
MARIADB_ROOT_PASSWORD=change_me_root
MARIADB_DATABASE=wikipedia
MARIADB_USER=ovr
MARIADB_PASSWORD=change_me
INNODB_BUFFER_POOL_SIZE=2G

# ---------------------------------------------------------------------------
# AI inference: any OpenAI-compatible /v1 endpoint — a locally deployed model
# or a hosted API key. The same config drives verdict entailment, claim
# extraction, RAG synthesis and resolution translation (server/llm.py,
# jobs/extract_claims.py, jobs/rerank_claims.py).
#
# Local model, one command:
#   docker compose --profile local-llm up -d ollama
#   docker compose exec ollama ollama pull qwen3:8b
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_MODEL=qwen3:8b
# Other local servers work identically, e.g.
#   LLM_BASE_URL=http://host.docker.internal:8000/v1   # vLLM on the host
#   LLM_BASE_URL=http://host.docker.internal:1234/v1   # LM Studio on the host
# Hosted API key, e.g.
#   LLM_BASE_URL=https://api.openai.com/v1     LLM_API_KEY=sk-... LLM_MODEL=gpt-4o-mini
#   LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_API_KEY=...   LLM_MODEL=...
# OPENAI_BASE_URL / OPENAI_API_BASE and OPENAI_API_KEY are accepted as aliases.
# Leave LLM_BASE_URL/LLM_MODEL empty to run without an LLM: verdicts fall back
# to the deterministic layer and jobs/extract_rules.py extracts claims LLM-free.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional JSON merged into every chat request body for provider-specific
# parameters, e.g. {"thinking": {"type": "disabled"}} for Kimi models.
LLM_EXTRA_BODY=
# Sent only when non-empty (reasoning models): low | medium | high
LLM_REASONING_EFFORT=

# ---------------------------------------------------------------------------
# Embeddings: any OpenAI-compatible /v1/embeddings endpoint.
# Default: the local `embedder` compose service (CPU). Local GPU worker:
#   EMBED_API_KEY=<token> docker compose --profile gpu up -d embedder-gpu
#   EMBED_BASE_URL=http://embedder-gpu:8002/v1
# Hosted, e.g. EMBED_BASE_URL=https://api.openai.com/v1 with EMBED_API_KEY.
# NOTE: EMBED_MODEL dimensions must match VECTOR(1024) in db/schema.sql.
EMBED_BASE_URL=http://embedder:8001/v1
EMBED_API_KEY=
EMBED_MODEL=intfloat/multilingual-e5-large

# Deployment networking. Loopback by default: only this machine can reach the
# app. Set OVR_PUBLIC_BIND=0.0.0.0 to publish it (only behind auth/rate limits);
# expose 8080 (web), never 8000 or 3306 directly.
OVR_PUBLIC_BIND=127.0.0.1
POST_RATE_LIMIT_PER_MINUTE=12
