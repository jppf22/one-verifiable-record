{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.4.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.wikipedia.org/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_appName__"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wikipedia.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
