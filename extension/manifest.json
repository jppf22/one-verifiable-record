{
  "manifest_version": 3,
  "name": "One Verifiable Record",
  "version": "0.2.3",
  "description": "Shows precomputed cross-language comparison findings for tracked Finnish, Swedish and English Wikipedia articles.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://fi.wikipedia.org/*",
    "https://sv.wikipedia.org/*",
    "https://en.wikipedia.org/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fi.wikipedia.org/*",
        "https://sv.wikipedia.org/*",
        "https://en.wikipedia.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
